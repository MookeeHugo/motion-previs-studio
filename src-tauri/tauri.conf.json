{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Motion Previs Studio",
  "version": "2.0.0",
  "identifier": "studio.motionprevis.app",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build:if-needed",
    "beforeDevCommand": "node scripts/dev.js --port 5173",
    "devUrl": "http://127.0.0.1:5173"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "title": "Motion Previs Studio — 动作预演",
      "width": 1600,
      "height": 1000,
      "minWidth": 1200,
      "minHeight": 800,
      "resizable": true,
      "fullscreen": false,
      "center": true
    }],
    "security": { "csp": null }
  },
  "plugins": {
    "opener": {}
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico", "icons/icon.icns"],
    "resources": ["../mcp"],
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
