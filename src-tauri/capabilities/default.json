{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main Motion Previs Studio window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "dialog:default",
    "fs:default",
    "opener:default",
    "shell:default",
    "shell:allow-open",
    "process:default",
    "process:allow-exit",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://**" }]
    }
  ]
}
